# ============================================================================
# EQUA ERP — contoh konfigurasi env. Salin ke `.env.local` untuk dev lokal.
# Semua variabel OPSIONAL di dev (punya bawaan di src/lib/env.ts). Di Vercel isi lewat Project Settings → Environment
# Variables. Jangan pernah commit rahasia asli.
# ============================================================================

# --- Basis data --------------------------------------------------------------
# pglite (bawaan dev/test, tanpa server) | neon (produksi Vercel) | pg (Postgres biasa)
DB_DRIVER=pglite
# Wajib bila DB_DRIVER=neon/pg. Neon: ambil "pooled connection string" dari Vercel Marketplace → Neon.
DATABASE_URL=
# Direktori data PGlite (hanya DB_DRIVER=pglite). Satu direktori = satu proses.
PGLITE_DATA_DIR=./.data/pglite

# --- Aplikasi & keamanan -----------------------------------------------------
# URL publik aplikasi (tautan di e-mail/WA, CORS, cron GitHub Actions).
APP_URL=http://localhost:3000
# Rahasia penandatangan sesi/token (min 32 karakter). Produksi: `openssl rand -base64 48`.
SESSION_SECRET=
# Token Bearer untuk /api/cron/* (Vercel Cron & GitHub Actions). Produksi: nilai acak panjang.
CRON_SECRET=
# Token penghubung GPS truk → POST /api/gps/ingest (M12).
GPS_INGEST_TOKEN=

# --- Penyimpanan berkas (foto bukti kirim, meter, nota) ---------------------
# Vercel Blob. Kosong = adaptor lokal (dev/test).
BLOB_READ_WRITE_TOKEN=

# --- E-mail (ringkasan harian) ----------------------------------------------
# Resend (free tier). Kosong = e-mail hanya dicatat ke log.
RESEND_API_KEY=
EMAIL_FROM=EQUA <noreply@equa.local>

# --- Web Push (VAPID) ---------------------------------------------------------
# Buat pasangan kunci: `pnpm dlx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@equa.local

# --- Peta & rute --------------------------------------------------------------
# straight_line_x1_3 (bawaan, tanpa layanan luar) | osrm | google
MAP_ROUTING_PROVIDER=straight_line_x1_3
# URL server OSRM (bila osrm) dan kunci API (bila google).
MAP_ROUTING_URL=
MAP_ROUTING_API_KEY=

# --- WhatsApp -----------------------------------------------------------------
# link (tautan wa.me semi-otomatis, Tahap 1) | cloud_api (WhatsApp Cloud API Meta, Tahap 2)
WA_PROVIDER=link
# Wajib bila WA_PROVIDER=cloud_api.
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_ID=

# --- Gerbang pembayaran (Tahap 2, PTB-50) ------------------------------------
# none | midtrans
PAYMENT_GATEWAY=none
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# true = produksi Midtrans; false = sandbox.
MIDTRANS_IS_PRODUCTION=false
